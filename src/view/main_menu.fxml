<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="view" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Main_menuController">
    <children>
        <Group fx:id="uiRoot">
            <children>
               <ImageView fx:id="bgImage" fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../image/mainMenu.png" />
                  </image>
               </ImageView>
               <Button fx:id="btnloadg" layoutX="250.0" layoutY="330.0" mnemonicParsing="false" onAction="#handlebtnloadgaction" prefHeight="27.0" prefWidth="103.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
               <Button fx:id="btnnewg" layoutX="144.0" layoutY="330.0" mnemonicParsing="false" onAction="#handlebtnnewgaction" prefHeight="27.0" prefWidth="83.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
            <Button fx:id="btnexit" layoutX="374.0" layoutY="331.0" mnemonicParsing="false" onAction="#handlebtnexitaction" prefHeight="26.0" prefWidth="86.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
            </children>
        </Group>
    </children>
</StackPane>
