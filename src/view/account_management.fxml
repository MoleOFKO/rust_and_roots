<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="view" styleClass="rich-table" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Account_managementController">
    <children>
        <Group fx:id="uiRoot">
            <children>
               <Pane layoutX="25.0" layoutY="190.0" prefHeight="43.0" prefWidth="164.0" style="-fx-background-color: black; -fx-background-radius: 10px;" />
               <Label layoutX="49.0" layoutY="42.0" text="Admin :" />
               <Label fx:id="txtaname" layoutX="106.0" layoutY="42.0" text="Name" />
               <Button fx:id="btnecharacter" layoutX="37.0" layoutY="238.0" mnemonicParsing="false" onAction="#handlebtnecharacteraction" prefWidth="139.0" text="Edit Character" />
               <Button fx:id="btneitem" layoutX="37.0" layoutY="158.0" mnemonicParsing="false" onAction="#handlebtneitemaction" prefWidth="139.0" text="Edit Item" />
               <Button fx:id="btnaccmanagement" layoutX="37.0" layoutY="198.0" mnemonicParsing="false" onAction="#handlebtnaccmanagementaction" prefHeight="25.0" prefWidth="139.0" text="Account Management" />
               <Button fx:id="btnvplayer" layoutX="37.0" layoutY="118.0" mnemonicParsing="false" onAction="#handlebtnvplayeraction" prefWidth="139.0" text="Account View" />
               <Button fx:id="btnlogout" layoutX="37.0" layoutY="278.0" mnemonicParsing="false" onAction="#handlebtnlogoutaction" prefWidth="139.0" text="Logout" />
               <TableView fx:id="account_view" layoutX="217.0" layoutY="79.0" prefHeight="412.0" prefWidth="642.0" stylesheets="@../css/tableview-rich.css">
                  <columns>
                     <TableColumn fx:id="colaccname" prefWidth="149.5" text="Account Name" />
                     <TableColumn fx:id="colemail" prefWidth="191.0" text="Email" />
                     <TableColumn fx:id="user_type" prefWidth="74.0" text="UserType" />
                     <TableColumn fx:id="colstatus" prefWidth="57.5" text="Status" />
                     <TableColumn fx:id="colcreateddate" prefWidth="143.0" text="Created Date" />
                  </columns>
               </TableView>
               <TextField fx:id="txtsearch" layoutX="217.0" layoutY="40.0" prefHeight="25.0" prefWidth="164.0" promptText="Enter Name To Search...." />
               <Button fx:id="btnedit" layoutX="262.0" layoutY="512.0" mnemonicParsing="false" onAction="#handlebtneditaction" prefHeight="25.0" prefWidth="75.0" text="Edit">
                  <graphic>
                     <FontAwesomeIcon glyphName="EDIT" />
                  </graphic>
               </Button>
               <Button fx:id="btnban" layoutX="486.0" layoutY="512.0" mnemonicParsing="false" onAction="#handlebanaction" prefHeight="25.0" prefWidth="100.0" style="-fx-background-color: red;" text="BAN" textFill="WHITE">
                  <graphic>
                     <FontAwesomeIcon fill="WHITE" glyphName="BAN" />
                  </graphic>
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Button>
               <Button fx:id="btnsearch" layoutX="381.0" layoutY="40.0" mnemonicParsing="false" onAction="#handlesearchaction">
                  <graphic>
                     <FontAwesomeIcon glyphName="SEARCH" />
                  </graphic>
               </Button>
               <Button fx:id="btnactive" layoutX="486.0" layoutY="512.0" mnemonicParsing="false" onAction="#handleactiveaction" prefHeight="25.0" prefWidth="100.0" style="-fx-background-color: green;" text="ACTIVATE" textFill="WHITE" visible="false">
                  <graphic>
                     <FontAwesomeIcon fill="WHITE" glyphName="CHECK" />
                  </graphic>
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Button>
            <Label layoutX="522.0" layoutY="30.0" />
            <Label layoutX="778.0" layoutY="531.0" />
            </children>
        </Group>
    </children>
</StackPane>
