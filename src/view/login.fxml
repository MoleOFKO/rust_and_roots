<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="view" prefHeight="379.0" prefWidth="598.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <children>
        <Group fx:id="uiRoot">
            <children>
               <Group fx:id="login_pane" layoutX="-2.0">
                  <children>
                     <ImageView fitHeight="400.0" fitWidth="607.0" layoutX="2.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-size: cover;">
                        <image>
                           <Image url="@../image/loginDesign.png" />
                        </image>
                     </ImageView>
                     <Pane layoutX="16.0" layoutY="16.0" prefHeight="365.0" prefWidth="240.0">
                        <children>
                           <TextField fx:id="txtlname" layoutX="50.0" layoutY="68.0" promptText="Gmail or User_name" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <PasswordField fx:id="txtlpassword" layoutX="50.0" layoutY="130.0" promptText="password" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <Hyperlink fx:id="sihl" layoutX="72.0" layoutY="183.0" onAction="#handlesihlaction" text="account create?" textFill="#9a5000">
                              <font>
                                 <Font name="System Bold" size="12.0" />
                              </font>
                           </Hyperlink>
                           <ImageView fitHeight="107.0" fitWidth="260.0" layoutX="35.0" layoutY="244.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../image/Loginbtn.png" />
                              </image>
                           </ImageView>
                           <Button fx:id="btnlogin" layoutX="68.0" layoutY="275.0" mnemonicParsing="false" onAction="#handlebtnloginaction" opacity="0.0" prefHeight="38.0" prefWidth="100.0" />
                        </children>
                     </Pane>
                  </children>
               </Group>
               <Group fx:id="sign_inpane" visible="false">
                  <children>
                     <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../image/signInDesign.png" />
                        </image>
                     </ImageView>
                     <Pane layoutX="336.0" layoutY="28.0" prefHeight="365.0" prefWidth="240.0">
                        <children>
                           <TextField fx:id="txtsname" layoutX="50.0" layoutY="114.0" promptText="Username" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <PasswordField fx:id="txtspassword" layoutX="50.0" layoutY="149.0" promptText="password" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <Hyperlink fx:id="lghl" layoutX="80.0" layoutY="220.0" onAction="#handlelghlaction" text="Have account?" textFill="#9a5000">
                              <font>
                                 <Font name="System Bold" size="12.0" />
                              </font>
                           </Hyperlink>
                           <PasswordField fx:id="txtscpassword" layoutX="50.0" layoutY="185.0" promptText="confirm password" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <TextField fx:id="txtsgmail" layoutX="50.0" layoutY="79.0" promptText="Gmail" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <ImageView fitHeight="107.0" fitWidth="191.0" layoutX="46.0" layoutY="256.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../image/SignInbtn.png" />
                              </image>
                           </ImageView>
                           <Button fx:id="btnsignin" layoutX="76.0" layoutY="283.0" mnemonicParsing="false" onAction="#handlebtnsigninaction" opacity="0.0" prefHeight="46.0" prefWidth="100.0" />
                        </children>
                     </Pane>
                  </children>
               </Group>
               <ImageView fitHeight="49.0" fitWidth="69.0" layoutX="515.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../image/xbtn.png" />
                  </image>
               </ImageView>
               <Button fx:id="btnclose" layoutX="524.0" layoutY="3.0" mnemonicParsing="false" onAction="#handlebtncloseaction" opacity="0.0" prefHeight="46.0" prefWidth="54.0" />
            </children>
        </Group>
    </children>
</StackPane>
