<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="view" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <children>
        <Group fx:id="uiRoot">
            <children>
               <Group fx:id="login_pane" layoutX="-2.0">
                  <children>
                     <ImageView fitHeight="400.0" fitWidth="607.0" layoutX="2.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-size: cover;">
                        <image>
                           <Image url="@../image/loginDesign.png" />
                        </image>
                     </ImageView>
                     <Pane layoutX="16.0" layoutY="16.0" prefHeight="365.0" prefWidth="240.0">
                        <children>
                           <TextField fx:id="txtlname" layoutX="50.0" layoutY="68.0" promptText="Email or Username" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <PasswordField fx:id="txtlpassword" layoutX="50.0" layoutY="130.0" promptText="Password" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <TextField fx:id="txtlpasswordvisible" layoutX="50.0" layoutY="130.0" managed="false" promptText="Password" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" visible="false" />
                           <Hyperlink fx:id="sihl" layoutX="72.0" layoutY="218.0" onAction="#handlesihlaction" text="Create an account?" textFill="#9a5000">
                              <font>
                                 <Font name="System Bold" size="12.0" />
                              </font>
                           </Hyperlink>
                           <ImageView fitHeight="107.0" fitWidth="260.0" layoutX="35.0" layoutY="244.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../image/Loginbtn.png" />
                              </image>
                           </ImageView>
                           <Button fx:id="btnlogin" layoutX="69.0" layoutY="276.0" mnemonicParsing="false" onAction="#handlebtnloginaction" prefHeight="35.0" prefWidth="96.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
                        <Hyperlink fx:id="forgotpwd" layoutX="75.0" layoutY="199.0" onAction="#handleforgetpwdaction" text="Forget Password?" textFill="#9a5000">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Hyperlink>
                        <FontAwesomeIcon fx:id="openlpassword" fill="WHITE" glyphName="EYE" layoutX="187.0" layoutY="150.0" onMouseClicked="#handleopenpasswordaction" size="1.5em" />
                        <FontAwesomeIcon fx:id="closedlpassword" fill="WHITE" glyphName="EYE_SLASH" layoutX="187.0" layoutY="150.0" onMouseClicked="#handlecolsedpasswordaction" size="1.5em" visible="false" />
                        </children>
                     </Pane>
                  </children>
               </Group>
               <Group fx:id="sign_inpane" visible="false">
                  <children>
                     <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../image/signInDesign.png" />
                        </image>
                     </ImageView>
                     <Pane layoutX="336.0" layoutY="28.0" prefHeight="365.0" prefWidth="240.0">
                        <children>
                           <TextField fx:id="txtsname" layoutX="50.0" layoutY="95.0" promptText="Username" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <PasswordField fx:id="txtspassword" layoutX="50.0" layoutY="169.0" promptText="Password" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <Hyperlink fx:id="lghl" layoutX="58.0" layoutY="239.0" onAction="#handlelghlaction" text="Already have an account?" textFill="#9a5000">
                              <font>
                                 <Font name="System Bold" size="12.0" />
                              </font>
                           </Hyperlink>
                           <PasswordField fx:id="txtscpassword" layoutX="50.0" layoutY="206.0" promptText="Confirm Password" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <TextField fx:id="txtsgmail" layoutX="50.0" layoutY="58.0" promptText="Gmail Address" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                           <ImageView fitHeight="107.0" fitWidth="191.0" layoutX="46.0" layoutY="256.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../image/SignInbtn.png" />
                              </image>
                           </ImageView>
                           <Button fx:id="btnsignin" layoutX="80.0" layoutY="288.0" mnemonicParsing="false" onAction="#handlebtnsigninaction" prefHeight="35.0" prefWidth="96.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
                        <TextField fx:id="otpcode" layoutX="50.0" layoutY="132.0" promptText="Enter Code" style="-fx-font-weight: bold;" styleClass="inputbox" stylesheets="@../css/style.css" />
                        <Button fx:id="btnotpsend" layoutX="10.0" layoutY="129.0" mnemonicParsing="false" onAction="#handlebtnotpsendaction" prefHeight="35.0" prefWidth="32.0" styleClass="invisible-button" stylesheets="@../css/style.css">
                           <graphic>
                              <FontAwesomeIcon glyphName="PAPER_PLANE" />
                           </graphic>
                        </Button>
                        </children>
                     </Pane>
                  </children>
               </Group>
               <ImageView fitHeight="49.0" fitWidth="69.0" layoutX="515.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../image/xbtn.png" />
                  </image>
               </ImageView>
               <Button fx:id="btnclose" layoutX="534.0" layoutY="22.0" mnemonicParsing="false" onAction="#handlebtncloseaction" prefHeight="26.0" prefWidth="32.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
            </children>
        </Group>
    </children>
</StackPane>
