                  <Button fx:id="btndelete" layoutX="53.0" layoutY="307.0" mnemonicParsing="false" onAction="#handledeleteaction" prefHeight="30.0" prefWidth="105.0" styleClass="invisible-button" stylesheets="@../css/style.css" />
