            </Group>
            <Group>
               <children>
                  <Rectangle fx:id="exit_left" height="48.0" layoutX="580.0" layoutY="132.0" opacity="0" width="15" />
                  <Rectangle fx:id="exit_up" height="15" layoutX="305.0" layoutY="8.0" opacity="0" width="51.0" />
