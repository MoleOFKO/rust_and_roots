<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="view" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Upper_mapController">
    <children>
        <Group fx:id="world">
         <children>
            <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../image/maps/upper_map_no.1.png" />
               </image>
            </ImageView>
            <Group fx:id="walls">
               <children>
                  <Rectangle fx:id="wall" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="398.0" stroke="BLACK" strokeType="INSIDE" width="8.0" />
                  <Rectangle fx:id="wall1" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="398.0" layoutX="593.0" stroke="BLACK" strokeType="INSIDE" width="8.0" />
                  <Rectangle fx:id="wall2" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="10.0" layoutX="8.0" stroke="BLACK" strokeType="INSIDE" width="586.0" />
                  <Rectangle fx:id="wall3" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="10.0" layoutX="8.0" layoutY="390.0" stroke="BLACK" strokeType="INSIDE" width="586.0" />
                  <Rectangle fx:id="wall4" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="50.0" layoutX="71.0" layoutY="172.0" stroke="BLACK" strokeType="INSIDE" width="196.0" />
                  <Rectangle fx:id="wall5" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="10.0" layoutX="90.0" layoutY="162.0" stroke="BLACK" strokeType="INSIDE" width="164.0" />
                  <Rectangle fx:id="wall6" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="11.0" layoutX="108.0" layoutY="223.0" stroke="BLACK" strokeType="INSIDE" width="126.0" />
                  <Rectangle fx:id="wall7" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="39.0" layoutX="264.0" layoutY="175.0" stroke="BLACK" strokeType="INSIDE" width="21.0" />
                  <Rectangle fx:id="wall8" arcHeight="5.0" arcWidth="5.0" fill="#1f93ff00" height="39.0" layoutX="63.0" layoutY="175.0" stroke="BLACK" strokeType="INSIDE" width="21.0" />
