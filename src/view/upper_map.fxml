                  <Rectangle fx:id="spawn_from_left" height="10" layoutX="560.0" layoutY="150.0" opacity="0" width="10" />
                  <Rectangle fx:id="spawn_from_up" height="10" layoutX="330.0" layoutY="23.0" opacity="0" width="10" />
                  <Rectangle fx:id="spawn_from_bottom" height="10" layoutX="456.0" layoutY="362.0" opacity="0" width="10" />
