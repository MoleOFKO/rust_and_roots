<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="view" prefHeight="557.0" prefWidth="922.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Edit_characterController">
    <children>
        <Group fx:id="uiRoot">
            <children>
               <Pane layoutX="24.0" layoutY="230.0" prefHeight="43.0" prefWidth="164.0" style="-fx-background-color: black; -fx-background-radius: 10px;" />
               <Label layoutX="49.0" layoutY="25.0" text="Admin :" />
               <Label fx:id="txtaname" layoutX="106.0" layoutY="25.0" text="Name" />
               <Button fx:id="btnecharacter" layoutX="37.0" layoutY="238.0" mnemonicParsing="false" onAction="#handlebtnecharacteraction" prefWidth="139.0" text="Edit Character" />
               <Button fx:id="btneitem" layoutX="37.0" layoutY="158.0" mnemonicParsing="false" onAction="#handlebtneitemaction" prefWidth="139.0" text="Edit Item" />
               <Button fx:id="btnaccmanagement" layoutX="37.0" layoutY="198.0" mnemonicParsing="false" onAction="#handlebtnaccmanagementaction" prefHeight="25.0" prefWidth="139.0" text="Account Management" />
               <Button fx:id="btnvplayer" layoutX="37.0" layoutY="118.0" mnemonicParsing="false" onAction="#handlebtnvplayeraction" prefWidth="139.0" text="Account View" />
               <Button fx:id="btnlogout" layoutX="37.0" layoutY="278.0" mnemonicParsing="false" onAction="#handlebtnlogoutaction" prefWidth="139.0" text="Logout" />
               <TableView fx:id="mob_view" layoutX="237.0" layoutY="84.0" prefHeight="418.0" prefWidth="668.0">
                  <columns>
                     <TableColumn fx:id="colmobid" prefWidth="70.0" text="Mobs ID" />
                     <TableColumn fx:id="colmobname" prefWidth="186.5" text="Mobs Name" />
                     <TableColumn fx:id="colmobtype" prefWidth="72.0" text="Mobs Type" />
                     <TableColumn fx:id="colstr" prefWidth="34.5" text="STR" />
                     <TableColumn fx:id="colagi" prefWidth="29.0" text="AGI" />
                     <TableColumn fx:id="colvit" prefWidth="33.0" text="VIT" />
                     <TableColumn fx:id="coldex" prefWidth="38.5" text="DEX" />
                     <TableColumn fx:id="colhp" minWidth="0.0" prefWidth="37.0" text="HP" />
                     <TableColumn fx:id="colstimana" prefWidth="54.0" text="Stamina" />
                     <TableColumn fx:id="mobimage" minWidth="0.0" prefWidth="111.0" text="Image" />
                  </columns>
               </TableView>
               <TextField fx:id="txtsearch" layoutX="237.0" layoutY="45.0" prefHeight="25.0" prefWidth="164.0" promptText="Enter Item Name To Search...." />
               <Button fx:id="btndelete" layoutX="543.0" layoutY="517.0" mnemonicParsing="false" onAction="#handlebtndeleteaction" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: red;" text="Delete" textFill="WHITE">
                  <graphic>
                     <FontAwesomeIcon fill="WHITE" glyphName="TRASH" />
                  </graphic>
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Button>
               <Button fx:id="btnsearch" layoutX="401.0" layoutY="45.0" mnemonicParsing="false" onAction="#handlesearchaction">
                  <graphic>
                     <FontAwesomeIcon glyphName="SEARCH" />
                  </graphic>
               </Button>
               <Button fx:id="btnedit" layoutX="378.0" layoutY="517.0" mnemonicParsing="false" onAction="#handlebtneditaction" prefHeight="25.0" prefWidth="75.0" text="EDIT">
                  <graphic>
                     <FontAwesomeIcon glyphName="EDIT" />
                  </graphic>
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Button>
               <Button fx:id="btnadd" layoutX="698.0" layoutY="517.0" mnemonicParsing="false" onAction="#handlebtnaddaction" prefHeight="25.0" prefWidth="75.0" text="ADD">
                  <graphic>
                     <FontAwesomeIcon glyphName="PLUS" />
                  </graphic>
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Button>
            </children>
        </Group>
    </children>
</StackPane>
