<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      <Pane fx:id="login_pane" layoutX="14.0" layoutY="16.0" prefHeight="365.0" prefWidth="240.0">
         <children>
            <Button fx:id="btnlogin" layoutX="99.0" layoutY="297.0" mnemonicParsing="false" onAction="#handlebtnloginaction" text="Login" />
            <TextField fx:id="txtlname" layoutX="50.0" layoutY="105.0" promptText="Gmail or User_name" />
            <PasswordField fx:id="txtlpassword" layoutX="50.0" layoutY="142.0" promptText="password" />
            <Label layoutX="98.0" layoutY="23.0" text="Login">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Hyperlink fx:id="sihl" layoutX="50.0" layoutY="186.0" onAction="#handlesihlaction" text="account create?" />
         </children>
      </Pane>
      <Pane fx:id="sign_inpane" layoutX="300.0" layoutY="18.0" prefHeight="365.0" prefWidth="240.0" visible="false">
         <children>
            <Button fx:id="btnsignin" layoutX="99.0" layoutY="297.0" mnemonicParsing="false" onAction="#handlebtnsigninaction" text="Sign_in" />
            <TextField fx:id="txtsname" layoutX="50.0" layoutY="114.0" promptText="Username" />
            <PasswordField fx:id="txtspassword" layoutX="50.0" layoutY="149.0" promptText="password" />
            <Label layoutX="98.0" layoutY="23.0" text="Sign-in">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Hyperlink fx:id="lghl" layoutX="50.0" layoutY="220.0" onAction="#handlelghlaction" text="Have account?" />
            <PasswordField fx:id="txtscpassword" layoutX="50.0" layoutY="185.0" promptText="confirm password" />
            <TextField fx:id="txtsgmail" layoutX="50.0" layoutY="79.0" promptText="Gmail" />
         </children>
      </Pane>
      <Button fx:id="btnclose" layoutX="548.0" layoutY="4.0" mnemonicParsing="false" onAction="#handlebtncloseaction">
         <graphic>
            <FontAwesomeIcon glyphName="CLOSE" />
         </graphic>
      </Button>
   </children>
</AnchorPane>
